#!/bin/bash

export PGHOST="{{ postgres_host }}"
export PGUSER="{{ sync_postgres_user }}"
export PGPASSWORD="{{ sync_postgres_password }}"
export PGPORT="{{ postgres_port }}"
export PGDATABASE="pve_cloud"

CRT=$(psql -t -A -c "SELECT ec_crt from public.acme_x509 where stack_fqdn = '{{ stack_name }}.{{ pve_cloud_domain }}';" | jq -r '.crt')
KEY=$(psql -t -A -c "SELECT ec_csr from public.acme_x509 where stack_fqdn = '{{ stack_name }}.{{ pve_cloud_domain }}';" | jq -r '.privkey')

# write cert to specified paths
{% for cert_path in stack_cert_sync_paths %}

# sync the cert
printf '%s\n' "$CRT" > '{{ cert_path.crt_path }}'

chown '{{ (cert_path.owner ~ ':' ~ cert_path.group) }}' '{{ cert_path.crt_path }}'
chmod '{{ cert_path.mode  }}' '{{ cert_path.crt_path }}'

# sync the key
printf '%s\n' "$KEY" > '{{ cert_path.key_path }}'

chown '{{ (cert_path.owner ~ ':' ~ cert_path.group) }}' '{{ cert_path.key_path }}'
chmod '{{ cert_path.mode  }}' '{{ cert_path.key_path }}'

{% endfor %}

# optional sync hook commands
{% if stack_cert_sync_hook_script is defined %}
{{ stack_cert_sync_hook_script }}
{% endif %}
