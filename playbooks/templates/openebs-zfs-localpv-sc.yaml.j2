apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: openebs-zfspv-zvol
allowVolumeExpansion: true
parameters:
  fstype: "ext4"
  poolname: "tank-pv"
provisioner: zfs.csi.openebs.io
allowedTopologies:
- matchLabelExpressions:
  - key: kubernetes.io/hostname
    values:
{% for node in pxzfs_storage_hosts %}
      - {{ node }}
{% endfor %}
