# we already install the crds seperately
openebs-crds:
  csi:
    volumeSnapshots:
      enabled: false

loki:
  enabled: false
alloy:
  enabled: false
engines:
  local:
    zfs:
      enabled: true # is enabled by default
    lvm:
      enabled: false
    rawfile:
      enabled: false
    hostpath:
      enabled: false
  replicated:
    mayastor:
      enabled: false

localpv-provisioner:
  hostpathClass:
    enabled: false

{% if harbor_mirror_secret.rowcount != 0 %}
  imagePullSecrets:
    - name: mirror-pull-secret
  localpv:
    image:
      registry: "{{ mirror_repo_host }}/"
      repository: cloud-mirror/docker.io/openebs/provisioner-localpv

{% endif %}


# deploy zfsNode plugin only on nodes that have zfs ready + set the needed tolerations
zfs-localpv:
  zfsNode:
    kubeletDir: "{{ openebs_zfs_kubelet_dir }}"
    nodeSelector:
      pxzfs-storage: 'true'
{% if collected_node_taints | flatten | length > 0 %}
    tolerations:
      # derived from kubespray node_taints of each worker node
{% for collected_taint in (collected_node_taints | flatten) %}
      - key: "{{ (collected_taint | split('='))[0] }}"
        value: "{{ ((collected_taint | split('='))[1] | split(':'))[0] }}"
        effect: "{{ ((collected_taint | split('='))[1] | split(':'))[1] }}"
{% endfor %}
{% endif %}
{% if harbor_mirror_secret.rowcount != 0 %}
    driverRegistrar:
      image:
        registry: "{{ mirror_repo_host }}/"
        repository: cloud-mirror/registry.k8s.io/sig-storage/csi-node-driver-registrar
  imagePullSecrets:
    - name: mirror-pull-secret
  zfsController:
    resizer:
      image:
        registry: "{{ mirror_repo_host }}/"
        repository: cloud-mirror/registry.k8s.io/sig-storage/csi-resizer
    snapshotter:
      image:
        registry: "{{ mirror_repo_host }}/"
        repository: cloud-mirror/registry.k8s.io/sig-storage/csi-snapshotter
    snapshotController:
      image:
        registry: "{{ mirror_repo_host }}/"
        repository: cloud-mirror/registry.k8s.io/sig-storage/snapshot-controller
    provisioner:
      image:
        registry: "{{ mirror_repo_host }}/"
        repository: cloud-mirror/registry.k8s.io/sig-storage/csi-provisioner
  zfsPlugin:
    image:
      registry: "{{ mirror_repo_host }}/"
      repository: cloud-mirror/docker.io/openebs/zfs-driver

{% endif %}
